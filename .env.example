# ── Server ───────────────────────────────
PORT=5000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
API_INTERNAL_TOKEN=change-me-internal

# ── Database ─────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ai-fashion-sales-assistant

# ── Orchestration ────────────────────────
ORCHESTRATION_MODE=direct
N8N_INBOUND_WEBHOOK_URL=

# ── LLM provider ─────────────────────────
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=text-embedding-004
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Embeddings / vector search ───────────
EMBEDDING_DIMS=768
VECTOR_BACKEND=auto
ATLAS_VECTOR_INDEX=product_embedding_index

# ── Instagram Graph API ──────────────────
IG_APP_ID=
IG_APP_SECRET=
IG_PAGE_ACCESS_TOKEN=
IG_VERIFY_TOKEN=change-me-verify
IG_GRAPH_VERSION=v21.0

# ── WhatsApp Business API ────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify
WHATSAPP_GRAPH_VERSION=v21.0

# ── Channels / testing ──────────────────
CHANNEL_TRANSPORT=live

# ── Voice / i18n ────────────────────────
VOICE_PROVIDER=mock
DEFAULT_LANGUAGE=en

# ── Admin auth ──────────────────────────
JWT_SECRET=change-me-jwt
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@brand.test
ADMIN_PASSWORD=change-me-admin
