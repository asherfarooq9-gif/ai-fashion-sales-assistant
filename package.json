{
  "name": "ai-fashion-sales-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @afsa/api",
    "dev:web": "npm run dev --workspace @afsa/web",
    "seed": "npm run seed --workspace @afsa/api",
    "build": "npm run build --workspace @afsa/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace @afsa/api",
    "test:web": "npm run test --workspace @afsa/web",
    "lint": "eslint . && npm run lint --workspace @afsa/web",
    "format": "prettier --write .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
